{
  "avatar": {
    "name": "Fahd — Tabuk",
    "url": "https://tabuk.clients.zorgelines.com/ar/demo?avatar=f7f6fe47f93446c1&mode=debug",
    "stepTimeoutMs": 20000
  },
  "retries": 1,
  "workflows": [
    {
      "name": "Site up + avatar renders",
      "steps": [
        {
          "action": "goto"
        },
        {
          "action": "expectNoConsoleErrors"
        }
      ]
    },
    {
      "name": "Conversation flow",
      "steps": [
        {
          "action": "goto"
        },
        {
          "action": "click",
          "selector": "#start-session"
        },
        {
          "action": "fill",
          "text": "السلام عليكم",
          "selector": "#chat-input"
        },
        {
          "action": "click",
          "selector": "#send"
        },
        {
          "action": "waitForResponseText",
          "selector": ".reply",
          "minLength": 3,
          "timeoutMs": 30000
        },
        {
          "action": "fill",
          "text": "رقم الهوية 1012345678",
          "selector": "#chat-input"
        },
        {
          "action": "click",
          "selector": "#send"
        },
        {
          "action": "expectText",
          "contains": "شكرا",
          "selector": ".reply",
          "timeoutMs": 30000
        }
      ]
    }
  ]
}